# Copy to `.env` and fill in. The real `.env` is gitignored.

# Supabase REST client (used by the app at runtime).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<service-role-key>

# JWT signing secret for auth tokens.
JWT_SECRET=<a-long-random-string>

# Direct Postgres connection used ONLY by the migration runner (app/db/migrate.py).
# Use the Supabase **Session pooler** connection string (Project Settings →
# Database → Connection string → Session, port 5432) — NOT the transaction pooler
# (6543), which doesn't preserve the session advisory lock. Append ?sslmode=require.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
