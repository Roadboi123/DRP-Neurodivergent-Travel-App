{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LegOption": {
        "description": "Details of an individual journey leg, transit or walking.",
        "properties": {
          "arrival": {
            "title": "Arrival",
            "type": "string"
          },
          "connection_waiting_mins": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": 0,
            "title": "Connection Waiting Mins"
          },
          "departure": {
            "title": "Departure",
            "type": "string"
          },
          "duration_mins": {
            "title": "Duration Mins",
            "type": "integer"
          },
          "instruction": {
            "title": "Instruction",
            "type": "string"
          },
          "line": {
            "title": "Line",
            "type": "string"
          },
          "mode": {
            "title": "Mode",
            "type": "string"
          },
          "stops": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stops"
          }
        },
        "required": [
          "mode",
          "line",
          "duration_mins",
          "departure",
          "arrival",
          "instruction"
        ],
        "title": "LegOption",
        "type": "object"
      },
      "PreferenceResponse": {
        "description": "Response body for ``GET /preferences/{username}``.\n\nSensitivity fields are always one of the ``SensitivityLevel`` labels (the\nservice maps stored integers back through ``REVERSE_SENSITIVITY_MAP``) or\n``None`` when a column is unset.",
        "properties": {
          "crowds": {
            "anyOf": [
              {
                "enum": [
                  "little",
                  "medium",
                  "high",
                  "veryhigh"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Crowds"
          },
          "lights": {
            "anyOf": [
              {
                "enum": [
                  "little",
                  "medium",
                  "high",
                  "veryhigh"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lights"
          },
          "noise": {
            "anyOf": [
              {
                "enum": [
                  "little",
                  "medium",
                  "high",
                  "veryhigh"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Noise"
          },
          "smell": {
            "anyOf": [
              {
                "enum": [
                  "little",
                  "medium",
                  "high",
                  "veryhigh"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Smell"
          },
          "temperature": {
            "anyOf": [
              {
                "enum": [
                  "little",
                  "medium",
                  "high",
                  "veryhigh"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Temperature"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username"
        ],
        "title": "PreferenceResponse",
        "type": "object"
      },
      "RouteFeature": {
        "description": "Color-coded sensory/efficiency feature badge for the route card.",
        "properties": {
          "color": {
            "title": "Color",
            "type": "string"
          },
          "icon": {
            "title": "Icon",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "label",
          "icon",
          "color"
        ],
        "title": "RouteFeature",
        "type": "object"
      },
      "RouteOption": {
        "description": "A single route suggestion returned by ``GET /routes/``.\n\nField names mirror the contract the React Native client consumes exactly,\nincluding the camelCase ``subName`` alongside the snake_case sensory fields.\nThis model is the single source of truth for the route contract: the\nfrontend's TS types are generated from it (see ``shared/`` and\n``scripts/export_openapi.py``). Annotations are kept precise so the generated\ntypes are precise, but JSON serialization is unchanged (``SensoryLevel`` still\nserializes as the integers 1/2/3).",
        "properties": {
          "crowds": {
            "enum": [
              1,
              2,
              3
            ],
            "title": "Crowds",
            "type": "integer"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "duration": {
            "title": "Duration",
            "type": "integer"
          },
          "features": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/RouteFeature"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Features"
          },
          "heat": {
            "enum": [
              1,
              2,
              3
            ],
            "title": "Heat",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "legs": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/LegOption"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Legs"
          },
          "light": {
            "enum": [
              1,
              2,
              3
            ],
            "title": "Light",
            "type": "integer"
          },
          "match_percentage": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Match Percentage"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "noise": {
            "enum": [
              1,
              2,
              3
            ],
            "title": "Noise",
            "type": "integer"
          },
          "price": {
            "title": "Price",
            "type": "number"
          },
          "sensory_description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sensory Description"
          },
          "sensory_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sensory Score"
          },
          "smell": {
            "enum": [
              1,
              2,
              3
            ],
            "title": "Smell",
            "type": "integer"
          },
          "subName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subname"
          },
          "type": {
            "enum": [
              "best",
              "quickest",
              "suggested"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "duration",
          "price",
          "noise",
          "crowds",
          "heat",
          "light",
          "smell",
          "description",
          "type"
        ],
        "title": "RouteOption",
        "type": "object"
      },
      "SensitivityPreferences": {
        "description": "Request body for ``POST /preferences/``.\n\nThe ``SensitivityLevel`` literal enforces the accepted labels, so invalid\nvalues are rejected with a 422 before the handler runs.",
        "properties": {
          "crowds": {
            "enum": [
              "little",
              "medium",
              "high",
              "veryhigh"
            ],
            "title": "Crowds",
            "type": "string"
          },
          "lights": {
            "enum": [
              "little",
              "medium",
              "high",
              "veryhigh"
            ],
            "title": "Lights",
            "type": "string"
          },
          "noise": {
            "enum": [
              "little",
              "medium",
              "high",
              "veryhigh"
            ],
            "title": "Noise",
            "type": "string"
          },
          "smell": {
            "enum": [
              "little",
              "medium",
              "high",
              "veryhigh"
            ],
            "title": "Smell",
            "type": "string"
          },
          "temperature": {
            "enum": [
              "little",
              "medium",
              "high",
              "veryhigh"
            ],
            "title": "Temperature",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "noise",
          "crowds",
          "temperature",
          "smell",
          "lights"
        ],
        "title": "SensitivityPreferences",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Calm Travel API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "root__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Root"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/preferences/": {
      "post": {
        "description": "Save sensory preferences from the user preferences screen.",
        "operationId": "save_preferences_preferences__post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SensitivityPreferences"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Save Preferences",
        "tags": [
          "preferences"
        ]
      }
    },
    "/preferences/{username}": {
      "get": {
        "operationId": "get_preferences_preferences__username__get",
        "parameters": [
          {
            "in": "path",
            "name": "username",
            "required": true,
            "schema": {
              "title": "Username",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PreferenceResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Preferences",
        "tags": [
          "preferences"
        ]
      }
    },
    "/routes/": {
      "get": {
        "description": "Return route suggestions, optionally personalized to a user's sensitivities.",
        "operationId": "get_routes_routes__get",
        "parameters": [
          {
            "in": "query",
            "name": "start",
            "required": true,
            "schema": {
              "title": "Start",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "end",
            "required": true,
            "schema": {
              "title": "End",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "username",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Username"
            }
          },
          {
            "in": "query",
            "name": "walking_speed",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": "slow",
              "title": "Walking Speed"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RouteOption"
                  },
                  "title": "Response Get Routes Routes  Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Routes",
        "tags": [
          "routes"
        ]
      }
    },
    "/supabase-test": {
      "get": {
        "description": "Round-trip an insert/select/delete against Supabase to verify connectivity.",
        "operationId": "supabase_healthcheck_supabase_test_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Supabase Healthcheck"
      }
    }
  }
}
